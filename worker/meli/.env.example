# Unidades do Dashboard Geral. O worker filtra a unidade efetiva por facilityId.
BASE_CODES=SSP3,SSP38,ESP15,SSP5,SSP20,ESP17,ESP16,SSP17,ESP18,SSP6,SSP45,SSP15,SSP37,SSP23,SSC2
WRITE_BASE_CODES=SSP3,SSP38,ESP15,SSP5,SSP20,ESP17,ESP16,SSP17,ESP18,SSP6,SSP45,SSP15,SSP37,SSP23,SSC2
SITE_ID=MLB

# JMRoutes (endpoint de ingestão já existente)
JMR_BASE_URL=https://jmroutes.app

# Supabase (usuário técnico — NUNCA service_role)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon/publishable key>
WORKER_EMAIL=worker.meli@<dominio>
WORKER_PASSWORD=<definido no cofre de secrets>

# Sessão AdminML cifrada (AES-256-GCM, chave de 32 bytes em base64)
WORKER_SESSION_KEY=<base64 32 bytes>
SESSION_FILE_PATH=/data/adminml-session.enc

# Ciclo: aguarda N segundos APÓS o término do ciclo anterior
SYNC_INTERVAL_SECONDS=60

# DRY_RUN=true: consulta o AdminML, NÃO envia ao endpoint de ingestão,
# NÃO grava telemetria e NÃO exige WORKER_EMAIL/WORKER_PASSWORD.
DRY_RUN=false

# Protocolo de lotes (staging + promoção atômica por base/dia).
# Mantenha "false" até a migration de lotes estar aplicada no banco.
SYNC_PROTOCOL_LOTES=false
